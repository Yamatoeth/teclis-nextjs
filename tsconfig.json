{
  "extends": [
    "./tsconfig-nextjs.json"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations":"6.0",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/app/*"],
      "@App/*": [ "./src/app/*"],
      "@/i18n/*": ["./src/i18n/*"]
    },
    "jsx": "preserve"
  },
  "include": [
    "src",
    ".next/types/**/*.ts"
  ]
}
